# PRF FTA Agent — Environment Variables
# Copy this to .env and fill in your values

# FTA Portal Credentials (PRF's shared login)
FTA_USERNAME=your-fta-username@email.com
FTA_PASSWORD=your-fta-portal-password

# Security — random secret key portal uses to call this server
# Generate one at: https://randomkeygen.com
AGENT_API_KEY=prf-fta-agent-secret-key-change-this

# Your Netlify portal URL (for CORS)
PORTAL_URL=https://prfclienthub.netlify.app

# Port (Railway sets this automatically)
PORT=3001
